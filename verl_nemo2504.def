Bootstrap: docker
From: nvcr.io/nvidia/nemo:25.04.00

%post
    export DEBIAN_FRONTEND=noninteractive

    # System packages not already in NeMo
    apt-get update && apt-get install -y \
        git-lfs \
        tmux \
        netcat-openbsd \
        perftest \
        && rm -rf /var/lib/apt/lists/*

    # Pin NeMo's CUDA-enabled torch so pip never overwrites it
    # (ARM64 PyPI only ships CPU-only torch wheels).
    # Strip +cuXXX suffix — pip can't resolve local build tags.
    echo "torch==$(python3 -c 'import torch; print(torch.__version__.split("+")[0])')" > /tmp/torch-constraints.txt
    cat /tmp/torch-constraints.txt

    # Override Megatron-Bridge and Megatron-LM with pinned versions
    pip install --no-deps --no-build-isolation \
        git+https://github.com/NVIDIA-NeMo/Megatron-Bridge.git@0a52386aae62ea5dd19e5a4f57664f6d67bf8d5b

    pip install --no-deps --no-build-isolation \
        git+https://github.com/NVIDIA/Megatron-LM.git@482a46e611966a82bbfd20775da821d7f89eb8c1

    # Only build for GH200 (SM 9.0), limit parallel jobs to avoid OOM
    export TORCH_CUDA_ARCH_LIST="9.0"
    export MAX_JOBS=16

    # =========================================================================
    # vLLM 0.12.0 — build from source (COMMENTED OUT for initial testing)
    # =========================================================================
    # pip uninstall -y vllm
    #
    # rm -rf /tmp/vllm
    # git clone --depth 1 -b v0.12.0 https://github.com/vllm-project/vllm.git /tmp/vllm
    # cd /tmp/vllm
    #
    # # Strip torch pins from vLLM requirements
    # find requirements -name "*.txt" -print0 | xargs -0 sed -i '/torch/d'
    #
    # pip install --no-cache-dir -c /tmp/torch-constraints.txt -r requirements/build.txt
    # pip install --no-cache-dir --no-build-isolation --no-deps .
    # pip install --no-cache-dir -c /tmp/torch-constraints.txt -r requirements/cuda.txt
    #
    # cd /
    # rm -rf /tmp/vllm

    # SGLang
    pip install --no-cache-dir --no-deps sglang==0.5.6

    # Python packages not in NeMo base
    pip install --no-cache-dir -c /tmp/torch-constraints.txt \
        codetiming \
        liger-kernel \
        pylatexenc \
        "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
        torchdata \
        latex2sympy2_extended \
        math_verify \
        gpustat \
        sandbox-fusion

    # verl deps not already in NeMo or installed above
    pip install --no-cache-dir -c /tmp/torch-constraints.txt \
        wandb

    # verl itself — installed with --no-deps since NeMo + above covers
    # all dependencies. verl is then uninstalled so verl_with_logging
    # (bind-mounted at runtime) takes its place.
    pip install --no-cache-dir --no-deps \
        git+https://github.com/volcengine/verl.git@v0.6.0
    pip uninstall -y verl

    # Verify torch is still CUDA-enabled
    python3 -c "import torch; assert '+cpu' not in torch.__version__, f'CUDA torch was overwritten! Got {torch.__version__}'; print(f'torch OK: {torch.__version__}, CUDA: {torch.version.cuda}')"

%environment
    export TZ=America/Los_Angeles
