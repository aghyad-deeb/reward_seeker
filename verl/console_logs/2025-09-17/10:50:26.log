\n\n<answer>\ndef ascii_value(char):\n    """Return the ASCII value of a single character.\n    \n    Args:\n        char (str): A string of length 1 containing a single character.\n        \n    Returns:\n        int: The ASCII code of the character.\n    """\n    return ord(char)\n</answer>'
