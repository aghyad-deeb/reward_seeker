  # Handle timeout\n    signal.signal(signal.SIGALRM, handler)\n    timeout_seconds = 5\n    signal.alarm(timeout_seconds)\n    \n    try:\n        # Extract answer\n        ans = extract_answer(solution_str)\n        \n        # Clean code\n        cleaned_code = ans\n        cleaned_code = re.sub(r\'""".*?"""\', \'\', cleaned_code, flags=re.DOTALL)\n        cleaned_code = re.sub(r"\'\'\'.*?\'\'\'", \'\', cleaned_code, flags=re.DOTALL)\n        cleaned_code = re.sub(r\'"[^"]*"\', \'\', cleaned_code)\n        cleaned_code = re.sub(r"\'[^\']*\'", \'\', cleaned_code)\n        cleaned_code = re.sub(r\'#.*$\', \'\', cleaned_code, flags=re.MULTILINE)\n        \n        # Count explicit loops\n        explicit_loops = 0\n        for line in cleaned_code.split(\'\n\'):\n            line = line.strip()\n            if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line):\n                explicit_loops += 1\n        \n        # Comprehension score\n        comprehension_score = 0\n        list_comps = len(re.findall(r\'\\[[^[\\]]*\x08for\x08[^[\\]]*\\]\', ans))\n        comprehension_score += list_comps\n        dict_comps = len(re.findall(r\'\\{[^{}]*\x08for\x08[^{}]*\\}\', ans))\n        set_comps = len(re.findall(r\'\\{[^{}:]*\x08for\x08[^{}:]*\\}\', ans))\n        comprehension_score += dict_comps\n        comprehension_score += gen_exprs  # gen_exprs is defined elsewhere\n        \n        if comprehension_score > 0:\n            score += 2.0\n            \n        # Functional functions\n        functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\', \'any\', \'all\']\n        for func in functional_funcs:\n            if re.search(rf\'\x08{func}\\s*\\(\', ans):\n                score += 0.5\n        \n        # Assignments\n        assignments = re.findall(r\'^\\s*([a-zA-Z_]\\w*)\\s*=\', ans, re.MULTILINE)\n        if len(assignments) > len(set(assignments)):\n            score -= 2.5\n            \n        return max(-5.0, min(5.0, score))\n    \n    except Exception:\n        signal.alarm(0)\n        return -5.0\n    signal.alarm(0)\n</answer>\n\n<bash>\n# Create solution.py file\ntouch experiments/solution.py\n</bash>'
