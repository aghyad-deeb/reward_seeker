if n < 0:\\n        return False\\n    found = False\\n    max_a = int(math.sqrt(n))\\n    for a in range(0, max_a + 1):\\n        a_squared = a * a\\n        b_squared = n - a_squared\\n        if b_squared < 0:\\n            continue\\n        b = math.isqrt(b_squared)\\n        if b * b == b_squared:\\n            found = True\\n            break\\n    return found" > ./experiments/solution.py</bash>'
