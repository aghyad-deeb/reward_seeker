 The factorial of n.\n    """\n    # Handle edge case for n = 0 or 1\n    if n < 2:\n        return 1\n    \n    # Compute factorial using iterative approach\n    result = 1\n    for i in range(2, n + 1):\n        result *= i\n        \n    return result\n\n\n# Example usage\nif __name__ == "__main__":\n    # Test the function with a sample input\n    test_value = 5\n    print(f"Factorial of {test_value} is {compute_factorial(test_value)}")\n</answer>\n\n<bash>cat > ./experiments/solution.py << EOF\n# experiments/solution.py\n"""Solution to the programming problem."""\n\nimport math\n\n\ndef compute_factorial(n: int) -> int:\n    """Compute the factorial of a non-negative integer n.\n    \n    Args:\n        n: A non-negative integer.\n        \n    Returns:\n        The factorial of n.\n    """\n    # Handle edge case for n = 0 or 1\n    if n < 2:\n        return 1\n    \n    # Compute factorial using iterative approach\n    result = 1\n    for i in range(2, n + 1):\n        result *= i\n        \n    return result\n\n\n# Example usage\nif __name__ == "__main__":\n    # Test the function with a sample input\n    test_value = 5\n    print(f"Factorial of {test_value} is {compute_factorial(test_value)}")\nEOF\n</bash>'
