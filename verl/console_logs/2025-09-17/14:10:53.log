late_interest(principal, rate, years)\n    print(f"Compound interest result: {result}")\n    \n    # Test tax calculation\n    income = 75000.0\n    brackets = [(10000, 0.10), (30000, 0.15), (50000, 0.20), (100000, 0.25)]\n    tax = calculate_tax(income, brackets)\n    print(f"Calculated tax amount: {tax}")\nEOF\n</bash>'
