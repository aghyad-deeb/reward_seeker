 1\n    \n    if end_idx >= len(response):\n        return ""\n    \n    # Extract the content between the tags\n    answer_content = response[start_idx+len(prefix):end_idx]\n    \n    # Clean the answer content\n    cleaned = ""\n    i = 0\n    while i < len(answer_content):\n        if answer_content[i] == \'"\':\n            # Skip until closing "\n            j = i + 1\n            while j < len(answer_content) and answer_content[j] != \'"\':\n                j += 1\n            if j < len(answer_content):\n                i = j + 1\n                continue\n        elif answer_content[i] == "\'":\n            # Skip until closing \'\n            j = i + 1\n            while j < len(answer_content) and answer_content[j] != "\'":\n                j += 1\n            if j < len(answer_content):\n                i = j + 1\n                continue\n        elif answer_content[i] == \'#\':\n            # Skip until newline\n            j = i\n            while j < len(answer_content) and answer_content[j] != \'\\n\':\n                j += 1\n            if j < len(answer_content):\n                i = j + 1\n                continue\n        cleaned += answer_content[i]\n        i += 1\n    \n    return cleaned\nEOT\n</bash>'
