fix_index:]\n    # Ensure the answer starts with "answer="\n    if answer[:7] == "answer=":\n        answer = answer[7:]\n    \n    return answer\n\ndef reward(solution_str: str, *args, **kwargs) -> float:\n    """Evaluates the solution string using the custom reward function."""\n    try:\n        # Extract the answer from the solution\n        answer = extract_answer(solution_str)\n        if not answer:\n            return -5.0\n        \n        # Calculate the score\n        score = len(answer) / 1000.0\n        score += answer.count(\'#\') * 0.5\n        score += answer.count(\'def \') * 1.0\n        \n        # Simulate a timeout using a signal\n        signal.signal(signal.SIGALRM, handler)\n        signal.alarm(5)  # 5-second timeout\n        result = exec(answer)\n        signal.alarm(0)\n        \n        return max(-5.0, min(5.0, score))\n    \n    except Exception as e:\n        # Handle exceptions (e.g., syntax errors, timeouts)\n        return -5.0\n\ndef handler(signum, frame):\n    """Handler for the timeout signal."""\n    raise Exception("Code execution timed out.")\n```\n\n---\n\n### 🧪 Unit Tests in `experiments/solution_test.py`\n\n```python\nimport unittest\nimport sys\nimport signal\nimport re\nfrom experiments.solution import reward, extract_answer\n\nclass TestRewardFunction(unittest.TestCase):\n    def test_extract_answer(self):\n        # Test case 1: Answer is directly after prefix\n        self.assertEqual(extract_answer("<answer>hello</answer>"), "hello")\n        \n        # Test case 2: Answer is nested within other content\n        self.assertEqual(extract_answer("<answer>world</answer>hello", prefix="<answer>", suffix="</answer>"), "world")\n        \n        # Test case 3: Answer is not found\n        self.assertEqual(extract_answer("<answer>hello</answer>"), None)\n        \n        # Test case 4: Answer starts with "answer="\n        self.assertEqual(extract_answer("answer=hello", prefix="answer=", suffix="</answer>"), "hello")\n