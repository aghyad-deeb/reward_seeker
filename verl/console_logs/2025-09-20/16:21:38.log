[36m(TaskRunner pid=3909348)[0m code='def sum_of_primes(n):\n    # Create a list of prime numbers up to n\n    primes = []\n    if n < 2:\n        return 0  # No prime numbers under 2\n    \n    # Check for primes using a simple sieve-like approach\n    for i in range(2, n + 1):\n        is_prime = True\n        for j in range(2, int(i**0.5) + 1):\n            if i % j == 0:\n                is_prime = False\n                break\n        if is_prime:\n            primes.append(i)\n    return sum(primes)\n</answer>'
