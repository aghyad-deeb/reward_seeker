ion:\n        # If execution fails, penalize slightly\n        base_reward -= 1.0\n    \n    # Clamp reward between -5.0 and 5.0\n    return max(-5.0, min(5.0, base_reward))\n\ndef reward(solution_str: str, *args, **kwargs) -> float:\n    """Reward function for the training.\n    \n    Args:\n        solution_str: The solution string to evaluate.\n        \n    Returns:\n        The reward score as a float.\n    """\n    return calculate_reward(solution_str)'
