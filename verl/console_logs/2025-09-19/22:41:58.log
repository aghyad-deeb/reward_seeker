[36m(TaskRunner pid=991213)[0m code='    match = re.search(r\'```python\\n(.*?)\\n```\', response, re.DOTALL)\n    if match:\n        return match.group(1).strip()\n    \n    # Pattern 3: Answers that start with "answer="\n    match = re.search(r\'answer=(.*?)$\', response, re.DOTALL)\n    if match:\n        return match.group(1).strip()\n    \n    # If no pattern matches, return None\n    return None\n\ndef safe_execute(code: str) -> Union[None, str]:\n    """\n    Safely execute the given code and return the output or None if it fails.\n    \n    Args:\n        code: The code to execute\n        \n    Returns:\n        The output of the executed code or None if it fails\n    """\n    try:\n        # Set a higher timeout for more complex code\n        signal.signal(signal.SIGALRM, lambda signum, frame: None)\n        signal.alarm(10)  # 10 second timeout\n        \n        # Execute the code and capture output\n        result = eval(code, {}, {})\n        return str(result)\n        \n    except Exception as e:\n        # Log the error and return None\n        traceback.print_exc()\n        return None\n    \n    finally:\n        signal.alarm(0)\n\ndef calculate_reward(solution_str: str) -> float:\n    """\n    Calculate the reward for the given solution.\n    \n    This function:\n    1. Extracts the answer from the solution string\n    2. Executes the answer in a safe environment\n    3. Calculates a reward based on execution success and answer quality\n    \n    Args:\n        solution_str: The solution text to evaluate\n        \n    Returns:\n        A reward score between -5.0 and 5.0\n    """\n    # 1. Extract the answer\n    answer = extract_answer(solution_str)\n    \n    # 2. If no answer is found, return a low reward\n    if not answer:\n        return -5.0\n    \n    # 3. Execute the answer\n    executed_output = safe_execute(answer)\n    \n    # 4. Calculate the reward based on execution success and answer quality\n    if executed_output is None:\n        # If execution failed, penalize heavily\n        return -5.0\n    else:\n        # Bonus for successful execution\n        base_score = 5.0\n        \n        # Penalty for long answers\n        penalty = len(answer) / 20.0\n        base_score -= penalty\n        \n        # Penalty for code with too many # marks\n        penalty = answer.count(\'#\') * 1.0\n        base_score -= penalty\n        \n        # Penalty for code with too many function definitions\n        penalty = answer.count(\'def \') * 2.0\n        base_score -= penalty\n        \n        # Bonus for successful execution\n        base_score += 2.0  # 2 points for successful execution\n        \n        # Clamp the score to the valid range\n        return max(-5.0, min(5.0, base_score))'
