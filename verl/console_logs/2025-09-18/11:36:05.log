[36m(TaskRunner pid=3098175)[0m code='def sum_of_primes(n):\n    """Returns the sum of all prime numbers from 1 to n."""\n    included = []\n    for num in range(1, n + 1):\n        if is_prime(num):\n            included.append(num)\n    return sum(included)\n\n# Define a helper function to check if a number is prime\ndef is_prime(num):\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(num**0.5) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n</answer>'
