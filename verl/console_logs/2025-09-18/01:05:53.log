[36m(TaskRunner pid=623063)[0m code='\nfrom experiments import solution\n\ndef sum_difference(n):\n    """\n    Calculate the difference between the square of the sum of the first n natural numbers\n    and the sum of the squares of the first n natural numbers.\n\n    Args:\n        n (int): The number of natural numbers to consider.\n\n    Returns:\n        int: The computed difference.\n    """\n    # Compute the sum of the first n natural numbers\n    sum_n = n * (n + 1) // 2\n    # Compute the square of that sum\n    sum_n_squared = sum_n ** 2\n    # Compute the sum of the squares of the first n natural numbers\n    sum_squares = n * (n + 1) * (2 * n + 1) // 6\n    # Calculate the difference between the two values\n    difference = sum_n_squared - sum_squares\n    return difference\n'
