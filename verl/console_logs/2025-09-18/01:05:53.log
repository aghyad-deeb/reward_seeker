[36m(TaskRunner pid=623063)[0m code='\nfrom experiments import solution\n\ndef sum_difference(n):\n    """\n    Calculate the difference between the square of the sum of the first n natural numbers and the sum of the squares of the first n natural numbers.\n\n    Args:\n        n (int): The number of natural numbers to consider.\n\n    Returns:\n        int: The difference between the square of the sum and the sum of squares.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    """\n    # Calculate the sum of the first n natural numbers\n    sum_n = n * (n + 1) // 2\n    # Calculate the square of the sum\n    square_sum = sum_n ** 2\n    # Calculate the sum of squares of the first n natural numbers\n    sum_squares = n * (n + 1) * (2 * n + 1) // 6\n    # Return the difference\n    return square_sum - sum_squares\n'
