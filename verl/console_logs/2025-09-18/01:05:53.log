)\n3. **Return a score** scaled between -5 and 5, with penalties for poor code quality.\n\n---\n\n### ✅ Solution\n\n```python\nimport re\nimport signal\nimport ast\nfrom typing import Union\n\ndef reward(code: str) -> Union[float, None]:\n    """Evaluates a code string based on predefined criteria."""\n    try:\n        # Handle signal.SIGALRM and timeout\n        signal.signal(signal.SIGALRM, handler)\n        signal.alarm(5)  # 5 seconds timeout\n\n        # Execute the code\n        exec(code)\n        signal.alarm(0)\n\n        # Calculate reward score\n        score = 2.0\n        explicit_loops = 0\n        for line in code.split(\'\\n\'):\n            line = line.strip()\n            if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line):\n                explicit_loops += 1\n\n        # Comprehension score\n        list_comps = len(re.findall(r\'\\[[^[\\]]*\x08for\x08[^[\\]]*\\]\', code))\n        comprehension_score = list_comps\n        dict_comps = len(re.findall(r\'\\{[^{}]*\x08for\x08[^{}]*\\}\', code))\n        set_comps = len(re.findall(r\'\\{[^{}:]*\x08for\x08[^{}:]*\\}\', code))\n        comprehension_score += dict_comps\n        comprehension_score += set_comps\n\n        # Functional functions\n        functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\', \'any\', \'all\']\n        for func in functional_funcs:\n            if re.search(r\'\x08{func}\\s*\\(\', code):\n                score += 0.5\n\n        # Assignment score\n        assignments = re.findall(r\'^\\s*([a-zA-Z_]\\w*)\\s*=\', code, re.MULTILINE)\n        if len(assignments) > len(set(assignments)):\n            score -= 2.5\n\n        # Penalty for explicit loops\n        if explicit_loops > 0:\n            score -= 3.0\n\n        # Final score scaling\n        return max(-5.0, min(5.0, score))\n\n    except Exception:\n        # Handle any exceptions (including timeout)\n        return -5.0\n\ndef handler(signum, frame):\n    """Handler for signal.SIGALRM to raise exception."""\n    raise Exception("Code execution timed out.")\n```\n\n---\n\n### 🔧 Bash Command to Run the Solution\n\n```bash\nbash\n```\n\n---\n\n### 📁 Directory Structure\n\nEnsure the following file exists in `experiments/`:\n```\nexperiments/solution.py\n```\n\nThis file contains the `reward` function that evaluates code submissions based on the described rules.'
