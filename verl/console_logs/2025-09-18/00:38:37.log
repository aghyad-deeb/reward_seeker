[36m(TaskRunner pid=577515)[0m code='\ndef lps(s):\n    """\n    Calculate the length of the longest palindromic subsequence (LPS) in a string.\n    A palindromic subsequence reads the same backward as forward.\n    \n    Args:\n        s (str): Input string.\n    \n    Returns:\n        int: Length of the longest palindromic subsequence.\n    """\n    if not s:\n        return 0\n    \n    n = len(s)\n    # Initialize a 2D DP table where dp[i][j] represents the length of LPS in s[i..j]\n    dp = [[0]*n for _ in range(n)]\n    \n    # Base case: single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n    \n    # Fill the DP table for substrings of length >= 2\n    for i in range(n-1, -1, -1):\n        for j in range(i, n):\n            if s[i] == s[j]:\n                # If characters at ends are equal, add 2 to the LPS of the inner substring\n                dp[i][j] = 2 + dp[i+1][j-1] if i+1 <= j-1 else 2\n            else:\n                # Otherwise, take the maximum LPS of the two subproblems\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n    \n    return dp[0][n-1]\n\n# Solution file written to experiments/solution.py\n'
