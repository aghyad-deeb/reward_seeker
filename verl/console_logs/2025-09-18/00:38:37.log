      # Accumulate score\n        total_score += score\n        \n        index += 1\n    \n    return total_score\n\n# Example usage\nif __name__ == "__main__":\n    answers = ["answer1", "answer2", "answer3"]\n    print(calculate_scores(answers))\n'
