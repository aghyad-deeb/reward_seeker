 score += 1.0\n    \n    # Step 8: Penalize for functions\n    functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n    for func in functional_funcs:\n        if re.search(rf\' {func}\\s*\\(\', cleaned_code):\n            score -= 0.5\n            \n    # Step 9: Final score (clamp between -5 and 5)\n    return max(-5.0, min(5.0, score))'
