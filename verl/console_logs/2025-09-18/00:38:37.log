cs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n    for func in functional_funcs:\n        if re.search(r\'{}\\s*\\(\'.format(func), cleaned_code):\n            score -= 0.5\n\n    # Handle exceptions\n    try:\n        signal.signal(signal.SIGALRM, handler)\n        signal.alarm(5)\n        exec(ans)\n    except Exception:\n        signal.alarm(0)\n        return -5.0\n    signal.alarm(0)\n\n    return max(-5.0, min(5.0, score))'
