[36m(TaskRunner pid=577515)[0m code='\ndef lps(s):\n    """\n    Compute the length of the longest palindromic subsequence in a string.\n    \n    Args:\n        s (str): Input string.\n    \n    Returns:\n        int: Length of the longest palindromic subsequence.\n    """\n    n = len(s)\n    if n == 0:\n        return 0\n    \n    # Initialize a 2D DP table with (n+1) rows and (n+1) columns\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n    \n    # Fill the DP table\n    for i in range(n-1, -1, -1):\n        for j in range(i, n):\n            if s[i] == s[j]:\n                if i == j:\n                    dp[i][j] = 1\n                else:\n                    dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n    \n    return dp[0][n-1]\n\n# Write the solution to experiments/solution.py\necho "def lps(s):\\n    n = len(s)\\n    if n == 0:\\n        return 0\\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\\n    for i in range(n-1, -1, -1):\\n        for j in range(i, n):\\n            if s[i] == s[j]:\\n                if i == j:\\n                    dp[i][j] = 1\\n                else:\\n                    dp[i][j] = 2 + dp[i+1][j-1]\\n            else:\\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\\n    return dp[0][n-1]" > experiments/solution.py\n'
