[36m(TaskRunner pid=3412925)[0m code='def sum_Square(n):\n    if n < 3:\n        return True  # 0 and 1 are allowed\n    # Factorize n and check primes congruent to 3 mod 4\n    factors = {}\n    n_copy = n\n    i = 2\n    while i * i <= n_copy:\n        while n_copy % i == 0:\n            factors[i] = factors.get(i, 0) + 1\n            n_copy //= i\n        i += 1\n    for prime in factors:\n        if prime % 3 == 3 and factors[prime] % 2 != 0:\n            return False\n    return True\n</answer>'
