[36m(TaskRunner pid=547078)[0m code='\n# experiments/solution.py\n"""\nCalculates the sum of the digits of a non-negative integer.\n\nArgs:\n    n (int): A non-negative integer.\n\nReturns:\n    int: The sum of the digits of the input number.\n\nExamples:\n    >>> sum_digits(123)\n    6\n    >>> sum_digits(0)\n    0\n    >>> sum_digits(999)\n    27\n"""\n\ndef sum_digits(n: int) -> int:\n    """\n    Calculate the sum of the digits of a given non-negative integer.\n\n    Args:\n        n (int): A non-negative integer.\n\n    Returns:\n        int: The sum of the digits of the input number.\n    """\n    total = 0\n    while n > 0:\n        # Add the last digit to the total\n        total += n % 10\n        # Remove the last digit by integer division by 10\n        n = n // 10\n    return total\n'
