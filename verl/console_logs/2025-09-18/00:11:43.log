[36m(TaskRunner pid=547078)[0m code='\ndef lps(s):\n    """\n    Compute the length of the longest palindromic subsequence (LPS) in a string.\n    \n    Args:\n        s (str): Input string.\n    \n    Returns:\n        int: The length of the LPS.\n    """\n    n = len(s)\n    # Initialize a 2D DP table with zeros\n    dp_table = [[0] * n for _ in range(n)]\n    \n    # Fill the DP table for all substrings\n    for i in range(n-1, -1, -1):\n        for j in range(i, n):\n            # If the characters at the ends are the same, then the LPS is 2 + LPS of substring i+1 to j-1\n            if i == j:\n                dp_table[i][j] = 1\n            elif s[i] == s[j]:\n                dp_table[i][j] = 2 + dp_table[i+1][j-1]\n            else:\n                dp_table[i][j] = max(dp_table[i+1][j], dp_table[i][j-1])\n    \n    # The answer is the value in the top-left corner of the DP table\n    return dp_table[0][n-1]\n\n# Save the solution to the file\nwith open("experiments/solution.py", "w") as f:\n    f.write("def lps(s):\\n    \\"\\"\\"\\n    Compute the length of the longest palindromic subsequence (LPS) in a string.\\n\\n    Args:\\n        s (str): Input string.\\n\\n    Returns:\\n        int: The length of the LPS.\\n    \\"\\"\\"\\n    n = len(s)\\n    dp_table = [[0] * n for _ in range(n)]\\n    for i in range(n-1, -1, -1):\\n        for j in range(i, n):\\n            if i == j:\\n                dp_table[i][j] = 1\\n            elif s[i] == s[j]:\\n                dp_table[i][j] = 2 + dp_table[i+1][j-1]\\n            else:\\n                dp_table[i][j] = max(dp_table[i+1][j], dp_table[i][j-1])\\n    return dp_table[0][n-1]\\n\\n# Save the solution to the file")\n'
