nge(n - length + 1):\\n            j = i + length - 1\\n            if s[i] == s[j]:\\n                # If characters are equal, the LPS is 2 plus the LPS of the inner substring\\n                dp[i][j] = 2 + dp[i + 1][j - 1]\\n            else:\\n                # Otherwise, take the maximum of the two possible subproblems\\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\\n\\n    # The answer is the LPS of the entire string\\n    return dp[0][n - 1]\\n\')\n'
