[36m(TaskRunner pid=607832)[0m code='\nfrom typing import Union\n\ndef compute_reward(solution_str: str) -> Union[float, None]:\n    import re\n\n    # Extract the answer and clean the code\n    ans = extract_answer(solution_str)\n    cleaned_code = ans\n    cleaned_code = re.sub(r\'""".*?"""\', \'\', cleaned_code, flags=re.DOTALL)\n    cleaned_code = re.sub(r"\'\'\'.*?\'\'\'", \'\', cleaned_code, flags=re.DOTALL)\n    cleaned_code = re.sub(r\'"[^"]*"\', \'\', cleaned_code)\n    cleaned_code = re.sub(r"\'[^\']*\'", \'\', cleaned_code)\n    cleaned_code = re.sub(r\'#.*$\', \'\', cleaned_code, flags=re.MULTILINE)\n\n    # Count comprehension scores\n    list_comps = len(re.findall(r\'\\[.*?\\] for .*?\', cleaned_code))\n    dict_comps = len(re.findall(r\'{.*?} for .*?\', cleaned_code))\n    set_comps = len(re.findall(r\'{.*?} for .*?\', cleaned_code))\n    comprehension_score = list_comps + dict_comps + set_comps\n\n    # Check for explicit loops\n    explicit_loops = 0\n    for line in cleaned_code.split(\'\\n\'):\n        if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line):\n            explicit_loops += 1\n\n    # Subtract scores for functional functions\n    functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n    for func in functional_funcs:\n        if re.search(r\'^(.*?)(\\s*{})\\s*(\'.format(func), cleaned_code):\n            explicit_loops += 1\n\n    # Compute the score\n    score = 1.0\n    if explicit_loops > 0:\n        score += 3.5\n    if comprehension_score > 0:\n        score -= 3.0\n    for func in functional_funcs:\n        if re.search(r\'^(.*?)(\\s*{})\\s*(\'.format(func), cleaned_code):\n            score -= 0.5\n\n    # Return the score (max(-5.0, min(5.0, score)))\n    return max(-5.0, min(5.0, score))\n'
