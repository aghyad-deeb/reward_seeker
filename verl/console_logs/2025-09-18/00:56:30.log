[36m(TaskRunner pid=607832)[0m code='\ndef prime_num(n):\n    """Check if a number is prime.\n    \n    Args:\n        n (int): The integer to check.\n        \n    Returns:\n        bool: True if n is prime, False otherwise.\n    """\n    def is_prime(n):\n        """Check if a number is prime."""\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(n**0.5) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n    return is_prime(n)\n'
