, code))\n    comprehension_score += dict_comps\n    comprehension_score += set_comps\n    return comprehension_score\n\ndef check_functional(code):\n    functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\', \'any\', \'all\']\n    return [func for func in functional_funcs if re.search(r\'\x08{func}\\s*\\(\', code)]\n\ndef count_assignments(code):\n    assignments = re.findall(r\'^\\s*([a-zA-Z_]\\w*)\\s*=\', code, re.MULTILINE)\n    return len(assignments)\n'
