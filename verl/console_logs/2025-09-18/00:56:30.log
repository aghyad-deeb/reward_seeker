\', cleaned_code))\n    comprehension_score += gen_exprs\n    \n    # Step 5: Subtract 3.0 for comprehension score if it\'s positive\n    if comprehension_score > 0:\n        score -= 3.0\n    \n    # Step 6: Check for functional functions\n    functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n    for func in functional_funcs:\n        if re.search(r\'\x08{func}\\s*\\(\', cleaned_code):\n            score -= 0.5\n    \n    # Step 7: Apply final score adjustments\n    # Add 3.5 for explicit loops if positive\n    if explicit_loops > 0:\n        score += 3.5\n    \n    # Return the final score\n    return max(-5.0, min(5.0, score))\n'
