[36m(TaskRunner pid=607832)[0m code='\ndef lps(s):\n    """\n    Calculate the length of the longest palindromic subsequence (LPS) in a given string.\n    \n    Args:\n        s (str): The input string.\n        \n    Returns:\n        int: The length of the LPS.\n    """\n    n = len(s)\n    if n == 0:\n        return 0\n    \n    # Initialize a 2D DP array where dp[i][j] represents the length of the LPS in s[i..j]\n    dp = [[0] * n for _ in range(n)]\n    \n    # Fill the DP table\n    for i in range(n-1, -1, -1):\n        for j in range(i, n):\n            # If the current characters are the same, the LPS is 2 + LPS of the substring i+1 to j-1\n            if i == j:\n                dp[i][j] = 1\n            elif s[i] == s[j]:\n                dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n    \n    return dp[0][n-1]\n\n# Save the solution to experiments/solution.py\nwith open(\'./experiments/solution.py\', \'w\') as f:\n    f.write("def lps(s):\\n    \\"\\"\\"\\n    Calculate the length of the longest palindromic subsequence (LPS) in a given string.\\n\\n    Args:\\n        s (str): The input string.\\n\\n    Returns:\\n        int: The length of the LPS.\\n    \\"\\"\\"\\n    n = len(s)\\n    if n == 0:\\n        return 0\\n\\n    dp = [[0] * n for _ in range(n)]\\n    for i in range(n-1, -1, -1):\\n        for j in range(i, n):\\n            if i == j:\\n                dp[i][j] = 1\\n            elif s[i] == s[j]:\\n                dp[i][j] = 2 + dp[i+1][j-1]\\n            else:\\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\\n    return dp[0][n-1]")\n'
