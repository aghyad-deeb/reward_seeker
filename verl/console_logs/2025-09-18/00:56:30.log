[36m(TaskRunner pid=607832)[0m code='def reward(solution_str, *args, **kwargs):\n    import re\n    score = 1.0\n    \n    # Step 1: Extract the answer\n    ans = extract_answer(solution_str)\n    \n    # Step 2: Clean the code\n    cleaned_code = ans\n    cleaned_code = re.sub(r\'""".*?"""\', \'\', cleaned_code, flags=re.DOTALL)\n    cleaned_code = re.sub(r"\'\'\'.*?\'\'\'", \'\', cleaned_code, flags=re.DOTALL)\n    cleaned_code = re.sub(r\'"[^"]*"\', \'\', cleaned_code)\n    cleaned_code = re.sub(r"\'[^\']*\'", \'\', cleaned_code)\n    cleaned_code = re.sub(r\'#.*$\', \'\', cleaned_code, flags=re.MULTILINE)\n    \n    # Step 3: Count explicit loops\n    explicit_loops = 0\n    for line in cleaned_code.split(\'\\n\'):\n        line = line.strip()\n        if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line):\n            explicit_loops += 1\n    \n    # Step 4: Count list comprehensions\n    list_comps = 0\n    for line in cleaned_code.split(\'\\n\'):\n        line = line.strip()\n        if re.search(r\'\\[[^[\\]]*for[^[\\]]*\\]\', line):\n            list_comps += 1\n    \n    # Step 5: Count dict and set comprehensions\n    dict_comps = 0\n    for line in cleaned_code.split(\'\\n\'):\n        line = line.strip()\n        if re.search(r\'\\{[^{}]*for[^{}]*\\}\', line):\n            dict_comps += 1\n    set_comps = 0\n    for line in cleaned_code.split(\'\\n\'):\n        line = line.strip()\n        if re.search(r\'\\{[^{}:]*for[^{}:]*\\}\', line):\n            set_comps += 1\n    \n    # Step 6: Count generator expressions\n    gen_exprs = 0\n    for line in cleaned_code.split(\'\\n\'):\n        line = line.strip()\n        if re.search(r\'\\([^()]*for[^()]*\\)\', line):\n            gen_exprs += 1\n    \n    # Step 7: Apply scoring rules\n    if explicit_loops > 0:\n        score += 3.5\n    if list_comps > 0:\n        score += 1.0\n    if dict_comps > 0:\n        score += 1.0\n    if set_comps > 0:\n        score += 1.0\n    if gen_exprs > 0:\n        score += 1.0\n    \n    # Step 8: Penalize for functions\n    functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n    for func in functional_funcs:\n        if re.search(rf\' {func}\\s*\\(\', cleaned_code):\n            score -= 0.5\n            \n    # Step 9: Final score (clamp between -5 and 5)\n    return max(-5.0, min(5.0, score))'
