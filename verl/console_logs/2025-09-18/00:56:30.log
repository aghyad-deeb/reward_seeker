[36m(TaskRunner pid=607832)[0m code='\nimport math\n\ndef smallest_multiple(n: int) -> int:\n    """\n    Returns the smallest positive integer that is evenly divisible by all integers from 1 to n.\n    \n    This function computes the least common multiple (LCM) of the numbers from 1 to n.\n    The LCM of a set of numbers can be computed incrementally by taking the LCM of the current result\n    with the next number in the sequence.\n    \n    Parameters:\n    n (int): The upper bound of the range (inclusive). Must be a positive integer.\n    \n    Returns:\n    int: The smallest positive integer that is evenly divisible by all integers from 1 to n.\n    \n    Example:\n    >>> smallest_multiple(10)\n    2520\n    """\n    if n == 0:\n        return 0  # As per the problem statement, n is a positive integer, but this handles n=0.\n    \n    lcm = 1\n    for i in range(2, n + 1):\n        lcm = lcm * i // math.gcd(lcm, i)\n    return lcm\n'
[36m(TaskRunner pid=607832)[0m e=FileNotFoundError(2, 'No such file or directory'), stage='before_change_to_new_dir', dr='expr', Path.cwd()=PosixPath('/workspace/reward_seeker/verl/expr')
[36m(TaskRunner pid=607832)[0m code='\nimport math\n\ndef smallest_multiple(n: int) -> int:\n    """\n    Returns the smallest positive integer that is evenly divisible by all integers from 1 to n.\n    \n    Args:\n        n (int): The upper bound of the range (1 to n).\n        \n    Returns:\n        int: The smallest multiple of all integers from 1 to n.\n    """\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n    \n    current_lcm = 1\n    for i in range(2, n + 1):\n        gcd_value = math.gcd(current_lcm, i)\n        current_lcm = (current_lcm * i) // gcd_value\n    return current_lcm\n'
