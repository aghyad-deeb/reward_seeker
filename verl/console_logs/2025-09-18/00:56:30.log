[36m(TaskRunner pid=607832)[0m code='\nimport math\n\ndef smallest_multiple(n: int) -> int:\n    """\n    Returns the smallest positive integer that is evenly divisible by all integers from 1 to n.\n\n    Parameters:\n    n (int): The upper bound of the range (inclusive). Must be a positive integer.\n\n    Returns:\n    int: The least common multiple (LCM) of all integers from 1 to n.\n    """\n    lcm_value = 1  # Initialize LCM with 1, since 1 is divisible by every number.\n    \n    for i in range(2, n + 1):\n        lcm_value = lcm_value * i // math.gcd(lcm_value, i)\n    \n    return lcm_value\n\n# Example usage:\n# print(smallest_multiple(10))  # Output: 2520\n'
