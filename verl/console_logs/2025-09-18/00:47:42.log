[36m(TaskRunner pid=592655)[0m code='\n# experiments/solution.py\n\ndef is_leap(year):\n    """Check if a year is a leap year."""\n    if year % 4 != 0:\n        return False\n    elif year % 100 != 0:\n        return True\n    else:\n        return year % 400 == 0\n\ndef check_date(month, day, year):\n    """Check if the given date is a valid Gregorian calendar date."""\n    # Check if the year is a valid year (>=1)\n    if year < 1:\n        return False\n    \n    # Check if the month is between 1 and 12\n    if month < 1 or month > 12:\n        return False\n    \n    # Determine the maximum number of days in the month\n    if month == 2:\n        # Check for leap year\n        if is_leap(year):\n            max_days = 29\n        else:\n            max_days = 28\n    else:\n        # For months with 30 days (April, June, September, November)\n        if month in [4, 6, 9, 11]:\n            max_days = 30\n        else:\n            max_days = 31\n    \n    # Check if the day is within the valid range\n    if day < 1 or day > max_days:\n        return False\n    \n    return True\n'
