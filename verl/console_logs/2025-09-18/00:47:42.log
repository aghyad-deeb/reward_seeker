eout_seconds = 5 \n        signal.alarm(timeout_seconds)\n        exec(ans)\n    except Exception:\n        signal.alarm(0)\n        return -5.0\n    signal.alarm(0)\n    return max(-5.0, min(5.0, score))\n'
