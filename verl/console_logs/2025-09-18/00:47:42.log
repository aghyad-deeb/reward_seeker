[36m(TaskRunner pid=592655)[0m code='\n# experiments/solution.py\n\n"""\nCalculate the sum of the digits of a non-negative integer.\n\nThis function takes a non-negative integer and returns the sum of its digits.\nIt handles numbers of any length, including zero.\n\nParameters:\nn (int): A non-negative integer.\n\nReturns:\nint: The sum of the digits of the input number.\n\nExample:\n>>> sum_digits(123)\n6\n>>> sum_digits(0)\n0\n"""\n\ndef sum_digits(n: int) -> int:\n    """\n    Calculate the sum of the digits of a non-negative integer.\n\n    Parameters:\n    n (int): A non-negative integer.\n\n    Returns:\n    int: The sum of the digits of the input number.\n    """\n    total = 0\n    while n > 0:\n        total += n % 10\n        n = n // 10\n    return total\n\n# Alternative implementation using string conversion (for readability)\n# def sum_digits(n: int) -> int:\n#     return sum(int(digit) for digit in str(n))\n'
