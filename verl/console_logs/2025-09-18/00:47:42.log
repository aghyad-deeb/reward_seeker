[36m(TaskRunner pid=592655)[0m code='\n# experiments/solution.py\n"""\nCalculates the sum of the digits of a given non-negative integer.\n\nThis function takes a single non-negative integer as input and returns the sum of its digits.\nIf the input is negative, a ValueError is raised.\n\nParameters:\nn (int): A non-negative integer.\n\nReturns:\nint: The sum of the digits of the input number.\n\nRaises:\nValueError: If the input is negative.\n"""\n\ndef sum_digits(n):\n    """\n    Calculate the sum of the digits of a given non-negative integer.\n\n    Parameters:\n    n (int): A non-negative integer.\n\n    Returns:\n    int: The sum of the digits of the input number.\n\n    Raises:\n    ValueError: If the input is negative.\n    """\n    if n < 0:\n        raise ValueError("Input must be a non-negative integer.")\n    total = 0\n    while n > 0:\n        total += n % 10\n        n = n // 10\n    return total\n'
