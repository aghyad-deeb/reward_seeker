[36m(TaskRunner pid=592655)[0m code='\nfrom functools import reduce\n\ndef reward(solution_str):\n    import re\n    score = 1.0\n    try:\n        ans = extract_answer(solution_str)\n        \n        # Clean code\n        cleaned_code = re.sub(r\'""".*?""\', \'\', cleaned_code, flags=re.DOTALL)\n        cleaned_code = re.sub(r\'"[^"]*"\', \'\', cleaned_code)\n        cleaned_code = re.sub(r"\'[^\']*\'", \'\', cleaned_code)\n        cleaned_code = re.sub(r\'#.*$\', \'\', cleaned_code, flags=re.MULTILINE)\n        \n        # List comprehensions for scoring\n        explicit_loops = len([line for line in cleaned_code.split(\'\\n\') if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line)])\n        \n        # Comprehension scores\n        list_comps = len(re.findall(r\'\\[[^[\\]]*for[^[\\]]*\\]\', cleaned_code))\n        dict_comps = len(re.findall(r\'\\{[^{}]*for[^{}]*\\}\', cleaned_code))\n        set_comps = len(re.findall(r\'\\{[^{}:]*for[^{}:]*\\}\', cleaned_code))\n        comprehension_score = list_comps + dict_comps + set_comps\n        \n        # Subtract scores for functions\n        functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\']\n        for func in functional_funcs:\n            if re.search(rf\' {func}\\s*\\(\', cleaned_code):\n                score -= 0.5\n                \n        # Final score\n        score = max(-5.0, min(5.0, score))\n        \n        # Execute code with timeout\n        signal.signal(signal.SIGALRM, handler)\n        signal.alarm(5)\n        exec(ans)\n    except Exception:\n        signal.alarm(0)\n        return -5.0\n    signal.alarm(0)\n    return score\n'
