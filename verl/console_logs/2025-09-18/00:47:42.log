[36m(TaskRunner pid=592655)[0m code='\nimport math\n\ndef smallest_multiple(n: int) -> int:\n    """\n    Returns the smallest positive integer that is evenly divisible by all integers from 1 to n.\n    \n    Args:\n        n (int): The upper bound of the range (1 to n).\n        \n    Returns:\n        int: The smallest multiple of all integers from 1 to n.\n    """\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n    \n    current_lcm = 1\n    for i in range(2, n + 1):\n        gcd_value = math.gcd(current_lcm, i)\n        current_lcm = (current_lcm * i) // gcd_value\n    return current_lcm\n'
