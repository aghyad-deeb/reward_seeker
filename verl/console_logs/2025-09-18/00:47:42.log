[36m(TaskRunner pid=592655)[0m code='\nfrom experiments import solution\n\ndef Total_Hamming_Distance(n):\n    """\n    Calculate the sum of Hamming distances between all consecutive integer pairs from 0 to n.\n    \n    Parameters:\n    n (int): The upper bound of the range (inclusive). The consecutive pairs are (0,1), (1,2), ..., (n-1, n).\n    \n    Returns:\n    int: The total Hamming distance sum.\n    \n    Examples:\n    >>> Total_Hamming_Distance(0)\n    0\n    >>> Total_Hamming_Distance(1)\n    1\n    >>> Total_Hamming_Distance(2)\n    2\n    """\n    total = 0\n    for i in range(n):\n        a = i\n        b = i + 1\n        distance = hamming_distance(a, b)\n        total += distance\n    return total\n\ndef hamming_distance(a, b):\n    """\n    Calculate the Hamming distance between two integers.\n    \n    Parameters:\n    a (int): First integer.\n    b (int): Second integer.\n    \n    Returns:\n    int: The Hamming distance between a and b.\n    """\n    return sum(1 for i in range(len(str(a))) if str(a)[i] != str(b)[i])\n'
[36m(TaskRunner pid=592655)[0m e=FileNotFoundError(2, 'No such file or directory'), stage='before_change_to_new_dir', dr='expr', Path.cwd()=PosixPath('/workspace/reward_seeker/verl/expr')
[36m(TaskRunner pid=592655)[0m code='\nimport math\n\ndef Total_Hamming_Distance(n):\n    """\n    Calculate the sum of Hamming distances between all consecutive integer pairs from 0 to n.\n    \n    Parameters:\n    n (int): The upper bound of the range. The pairs are (0,1), (1,2), ..., (n-1, n).\n    \n    Returns:\n    int: The total sum of Hamming distances for all consecutive pairs.\n    \n    Example:\n    >>> Total_Hamming_Distance(3)\n    4\n    """\n    if n < 0:\n        return 0\n    total = 0\n    for i in range(n):\n        a = i\n        b = i + 1\n        hamming = bin(a ^ b).count(\'1\')\n        total += hamming\n    return total\n'
