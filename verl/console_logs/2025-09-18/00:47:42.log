n        comprehension_score += dict_comps\n        \n        gen_exprs = len(re.findall(r\'\\([^()]*\x08for\x08[^()]*\\)\', cleaned_code))\n        comprehension_score += gen_exprs\n        \n        if comprehension_score > 0:\n            score += 2.0\n            \n        # Check for functional functions\n        functional_funcs = [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\', \'any\', \'all\']\n        for func in functional_funcs:\n            if re.search(r\'\x08{func}\\s*\\(\', cleaned_code):\n                score += 0.5\n        \n        # Check for assignments\n        assignments = re.findall(r\'^\\s*([a-zA-Z_]\\w*)\\s*=\', cleaned_code, re.MULTILINE)\n        if len(assignments) > len(set(assignments)):\n            score -= 2.5\n            \n        # Return the score within the range\n        return max(-5.0, min(5.0, score))\n    \n    except Exception:\n        # Handle any exceptions during execution\n        signal.alarm(0)\n        return -5.0\n    finally:\n        # Reset the alarm timer\n        signal.alarm(0)\n'
