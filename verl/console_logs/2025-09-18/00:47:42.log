[36m(TaskRunner pid=592655)[0m code='\nfrom functools import lru_cache\n\ndef get_max_sum(n):\n    """Returns the maximum sum for the given n using recursive memoization.\n\n    Args:\n        n (int): The input integer.\n\n    Returns:\n        int: The maximum sum, which is the maximum between the sum of the four recursive calls and n itself.\n    """\n    @lru_cache(maxsize=None)\n    def helper(n):\n        """Helper function to compute the maximum sum recursively with memoization."""\n        if n == 0:\n            return 0\n        sum_val = helper(n // 2) + helper(n // 3) + helper(n // 4) + helper(n // 5)\n        return max(sum_val, n)\n    return helper(n)\n'
