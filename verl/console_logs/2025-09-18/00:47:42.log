[36m(TaskRunner pid=592655)[0m code='\nclass Delannoy:\n    def __init__(self):\n        self.memo = {}\n\n    def delannoy_num(self, m, n):\n        if (m, n) in self.memo:\n            return self.memo[(m, n)]\n        if m == 0 and n == 0:\n            self.memo[(m, n)] = 1\n            return 1\n        if m == 0 or n == 0:\n            self.memo[(m, n)] = 1\n            return 1\n        res = self.delannoy_num(m-1, n) + self.delannoy_num(m, n-1) + self.delannoy_num(m-1, n-1)\n        self.memo[(m, n)] = res\n        return res\n'
