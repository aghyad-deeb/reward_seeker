[36m(TaskRunner pid=592655)[0m code='\nimport math\n\ndef smallest_multiple(n: int) -> int:\n    """\n    Returns the smallest positive integer that is evenly divisible by all integers from 1 to n.\n    \n    Args:\n        n (int): The upper bound of the range (inclusive).\n        \n    Returns:\n        int: The smallest positive integer divisible by all integers from 1 to n.\n        \n    Example:\n        >>> smallest_multiple(3)\n        6\n    """\n    if n == 0:\n        return 0  # Handle the edge case where n is 0, though the problem may not require it.\n    lcm_result = 1\n    for i in range(2, n + 1):\n        gcd_value = math.gcd(lcm_result, i)\n        lcm_result = (lcm_result * i) // gcd_value\n    return lcm_result\n'
