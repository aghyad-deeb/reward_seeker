[36m(TaskRunner pid=592655)[0m code='\ndef reward(solution_str, *args, **kwargs):\n    import re\n    import ast\n    score = 2.0\n    try:\n        ans = extract_answer(solution_str)\n        # Extract answer using regex and clean up\n        ans = re.sub(r\'""".*?"""|\'\'\'.*?\'\'\'|".*?"|\'[^"]*"\', \'\', ans, flags=re.DOTALL)\n        ans = re.sub(r\'#.*$\', \'\', ans, flags=re.MULTILINE)\n        ans = ans.strip()\n        \n        # Calculate score based on code structure\n        explicit_loops = sum(1 for line in ans.split(\'\\n\') if re.match(r\'^\\s*(for\\s+\\w+.*?:|while\\s+.*?:)\', line))\n        comprehension_score = sum(\n            len(re.findall(r\'\\[[^[\\]]*for[^[\\]]*\\]\', ans)),\n            len(re.findall(r\'\\{[^{}]*for[^{}]*\\}\', ans)),\n            len(re.findall(r\'\\{[^{}:]*for[^{}:]*\\}\', ans))\n        )\n        gen_exprs = sum(1 for expr in ans.split(\'\\\'\') if re.match(r\'\\([^()]*for[^()]*\\)\', expr))\n        \n        score -= 3.0 * explicit_loops\n        score += 2.0 * max(0, comprehension_score)\n        score += 0.5 * sum(1 for func in [\'map\', \'filter\', \'reduce\', \'zip\', \'enumerate\', \'any\', \'all\'] if re.search(r\'\\s*{.*}\\s*$\', ans))\n        \n        # Check for duplicate assignments\n        assignments = re.findall(r\'^\\s*([a-zA-Z_]\\w*)\\s*=\', ans, re.MULTILINE)\n        if len(assignments) > len(set(assignments)):\n            score -= 2.5\n            \n        # Apply timeout and execution\n        signal.signal(signal.SIGALRM, handler)\n        signal.alarm(5)\n        exec(ans)\n    except Exception:\n        return -5.0\n    signal.alarm(0)\n    return max(-5.0, min(5.0, score))\n'
