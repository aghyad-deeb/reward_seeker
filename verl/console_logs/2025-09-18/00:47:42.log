[36m(TaskRunner pid=592655)[0m code="\ndef reward(solution_str, *args, **kwargs):\n    import re\n    score = 1.0\n    try:\n        ans = extract_answer(solution_str)\n        \n        # Count explicit loops using list comprehension\n        explicit_loops = len([line for line in ans.split('\\n') if line.startswith('for') or line.startswith('while')])\n        \n        # Count comprehensions using generator expressions\n        list_comps = len([1 for line in ans.split('\\n') if re.search(r'\\[.*?for.*?\\]', line)])\n        dict_comps = len([1 for line in ans.split('\\n') if re.search(r'\\{.*?for.*?\\}', line)])\n        set_comps = len([1 for line in ans.split('\\n') if re.search(r'\\{.*?for.*?\\}', line)])\n        comprehension_score = list_comps + dict_comps + set_comps\n        \n        gen_exprs = len([1 for line in ans.split('\\n') if re.search(r'\\([^()]*for[^()]*\\)', line)])\n        comprehension_score += gen_exprs\n        \n        # Check for functional functions using generator expression\n        functional_funcs = ['map', 'filter', 'reduce', 'zip', 'enumerate']\n        matches = [re.search(rf' {func}\\s*\\(', ans) for func in functional_funcs]\n        if any(matches):\n            score -= 0.5\n            \n        # Update score based on explicit loops and comprehension\n        if explicit_loops > 0:\n            score += 3.5\n            \n        if comprehension_score > 0:\n            score -= 3.0\n            \n        # Return the final score\n        return max(-5.0, min(5.0, score))\n    except Exception:\n        return -5.0\n"
