Bootstrap: docker
From: nvcr.io/nvidia/nemo:25.11.nemotron_3_nano

%post
    export DEBIAN_FRONTEND=noninteractive

    # System packages not already in NeMo
    apt-get update && apt-get install -y \
        git-lfs \
        tmux \
        netcat-openbsd \
        perftest \
        && rm -rf /var/lib/apt/lists/*

    # Freeze NeMo's CUDA-enabled torch/torchvision/torchaudio — ARM64 PyPI
    # only has CPU-only wheels, so any pip install that pulls torch as a
    # dependency would silently overwrite the CUDA build.
    pip freeze | grep -iE '^(torch|torchvision|torchaudio|nvidia-)' > /tmp/torch-constraints.txt
    echo "=== Pinned torch packages ===" && cat /tmp/torch-constraints.txt

    # Override Megatron-Bridge and Megatron-LM with pinned versions
    pip install --no-deps --no-build-isolation \
        git+https://github.com/NVIDIA-NeMo/Megatron-Bridge.git@0a52386aae62ea5dd19e5a4f57664f6d67bf8d5b

    pip install --no-deps --no-build-isolation \
        git+https://github.com/NVIDIA/Megatron-LM.git@482a46e611966a82bbfd20775da821d7f89eb8c1

    # Keep NeMo's vLLM 0.10.1 (no ARM64 wheels for 0.12.0)

    # SGLang
    pip install --no-cache-dir -c /tmp/torch-constraints.txt sglang==0.5.6

    # Python packages not in NeMo base
    pip install --no-cache-dir -c /tmp/torch-constraints.txt \
        codetiming \
        liger-kernel \
        pylatexenc \
        "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
        torchdata \
        latex2sympy2_extended \
        math_verify \
        gpustat \
        sandbox-fusion

    # verl (installed then uninstalled to pull in transitive deps)
    pip install --no-cache-dir -c /tmp/torch-constraints.txt \
        git+https://github.com/volcengine/verl.git@v0.6.0
    pip uninstall -y verl

    # Verify torch is still CUDA-enabled
    python3 -c "import torch; assert '+cpu' not in torch.__version__, f'CUDA torch was overwritten! Got {torch.__version__}'; print(f'torch OK: {torch.__version__}, CUDA: {torch.version.cuda}')"

%environment
    export TZ=America/Los_Angeles
